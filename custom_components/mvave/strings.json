{
  "config": {
    "flow_title": "{name} ({address})",
    "step": {
      "bluetooth_confirm": {
        "description": "Set up {name} as a control surface?"
      },
      "user": {
        "data": {
          "address": "Device"
        },
        "description": "Pick a BLE MIDI controller that is switched on and in range."
      }
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "no_devices_found": "No BLE MIDI controller was found. Switch it on, make sure nothing else is connected to it, and try again."
    }
  },
  "entity": {
    "binary_sensor": {
      "connected": {
        "name": "Connected"
      }
    },
    "event": {
      "pad": {
        "name": "Pad {number}",
        "state_attributes": {
          "event_type": {
            "state": {
              "press_start": "Pressed",
              "press_end": "Released"
            }
          }
        }
      },
      "knob": {
        "name": "Knob {number}",
        "state_attributes": {
          "event_type": {
            "state": {
              "clockwise": "Turned clockwise",
              "counter_clockwise": "Turned counter-clockwise"
            }
          }
        }
      }
    }
  },
  "exceptions": {
    "device_not_found": {
      "message": "Could not reach {address}: {reason}"
    }
  }
}
